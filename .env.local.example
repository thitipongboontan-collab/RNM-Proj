NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Admin auth — email of the single admin user (optional but recommended)
# If set, only this email can access /admin after login
ADMIN_EMAIL=admin@example.com

# Required for admin writes and npm run ai:index-embeddings (server-side only — never commit)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Required for npm run supabase:backup (direct Postgres connection — never commit)
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Prefer Session pooler on Windows (IPv4-friendly):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Or set only the database password (script tries pooler first, then direct host):
# SUPABASE_DB_PASSWORD=your_database_password_here
# SUPABASE_DB_REGION=ap-southeast-1

# OpenAI (server-side only — do NOT use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional embedding model for vector search (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Researcher expertise profiles (Phase A)
# Run supabase/researcher-expertise-profiles-schema.sql in the Supabase SQL editor.
# Admin review uses OPENAI_API_KEY when set, and still saves an evidence-weighted
# profile when the key is missing or the model response is invalid.

# Funding attachment text (admin-uploaded PDF/Word → matching + AI Assistant)
# Run supabase/funding-attachment-text-schema.sql in the Supabase SQL editor.
# Then npm run funding:extract-attachments to backfill existing files.
# New uploads extract automatically. Scanned PDFs are flagged; OCR is not applied.

# Optional: path to source funding folder for npm run funding:prepare
# FUNDING_SOURCE=D:\path\to\Funding

# Optional: path to researcher photos for npm run researchers:photos
# RESEARCHER_PHOTO_SOURCE=D:\path\to\ResearcherPhoto
