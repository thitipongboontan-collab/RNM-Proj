NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Required for npm run ai:index-embeddings (server-side only — never commit)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI (server-side only — do NOT use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional embedding model for vector search (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: path to source funding folder for npm run funding:prepare
# FUNDING_SOURCE=D:\path\to\Funding

# Optional: path to researcher photos for npm run researchers:photos
# RESEARCHER_PHOTO_SOURCE=D:\path\to\ResearcherPhoto
